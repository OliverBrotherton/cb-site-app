# Copy these into Vercel > your project > Settings > Environment Variables

# From Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=paste-the-service_role-secret-key

# Your admin PIN (6+ numbers). Unlocks every project and the project setup screens. Don't share it.
ADMIN_PIN=
# A long random string. Changing it locks every phone (everyone re-enters their PIN).
SESSION_SECRET=
# The web address of the app once it's live, e.g. https://cb-site-app.vercel.app
APP_URL=

# Email. Office 365 mailbox (ask IT to turn on "Authenticated SMTP" for it):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=snags@chasberger.co.uk
SMTP_PASS=
MAIL_FROM=Chas Berger Snags <snags@chasberger.co.uk>
